[Unit]
Description=CSR testnet job simulator (one tick)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=runsim
Group=runsim
ExecStart=/usr/bin/python3 /opt/runsim/sim.py --config /etc/runsim/runsim.ini tick
Nice=10
# small and sandboxed: no new privileges, read-only system, writes only to its data directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/runsim
MemoryMax=64M
CPUQuota=20%
TimeoutStartSec=300
